.home-page {
  padding: 28rpx 44rpx 180rpx;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 4rpx 0 58rpx;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-title {
  color: #252220;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.05;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: #a8a08e;
  font-size: 27rpx;
  line-height: 1.4;
}

.hero-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 18rpx;
  padding-top: 22rpx;
}

.round-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  min-width: 84rpx;
  max-width: 84rpx;
  height: 84rpx;
  min-height: 84rpx;
  max-height: 84rpx;
  box-sizing: border-box;
  padding: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #8a8270;
  box-shadow: 0 4rpx 18rpx rgba(37, 34, 32, 0.06);
}

.add-button {
  background: #c9583a;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 300;
  box-shadow: 0 10rpx 28rpx rgba(201, 88, 58, 0.22);
}

.round-icon {
  width: 42rpx;
  height: 42rpx;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  height: 92rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e8e4de;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(37, 34, 32, 0.06);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
}

.search-input {
  flex: 1;
  height: 92rpx;
  color: #252220;
  font-size: 28rpx;
}

.search-placeholder {
  color: #a8a08e;
}

.category-scroll,
.difficulty-scroll {
  width: 100%;
  margin: 38rpx 0 0;
  white-space: nowrap;
}

.difficulty-scroll {
  margin-top: 32rpx;
}

.category-row,
.difficulty-row {
  display: inline-flex;
  gap: 16rpx;
  min-width: 100%;
}

.category-pill,
.difficulty-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 96rpx;
  height: 64rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6b6355;
  font-size: 26rpx;
  font-weight: 650;
}

.category-icon {
  width: 28rpx;
  height: 28rpx;
}

.difficulty-pill {
  min-width: 84rpx;
  height: 52rpx;
  padding: 0 24rpx;
  font-size: 23rpx;
}

.category-pill.is-active,
.difficulty-pill.is-active {
  background: #c9583a;
  color: #ffffff;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 0 18rpx;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  width: 100%;
  margin-top: 36rpx;
}

.recipe-card {
  position: relative;
  display: flex;
  width: 100%;
  box-sizing: border-box;
  min-height: 208rpx;
  padding: 18rpx;
  text-align: left;
}

.recipe-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  min-width: 168rpx;
  height: 176rpx;
  border-radius: 20rpx;
  color: #ffffff;
}

.recipe-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.recipe-cover-icon {
  width: 58rpx;
  height: 58rpx;
  opacity: 0.72;
  filter: brightness(0) invert(1);
}

.favorite-button {
  position: absolute;
  top: 26rpx;
  right: 26rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(250, 249, 247, 0.88);
  box-shadow: 0 4rpx 14rpx rgba(37, 34, 32, 0.08);
}

.favorite-icon {
  width: 32rpx;
  height: 32rpx;
}

.recipe-body {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
  padding: 4rpx 70rpx 4rpx 22rpx;
}

.recipe-title {
  overflow: hidden;
  color: #252220;
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.mini-pill {
  display: inline-flex;
  align-items: center;
  max-width: 150rpx;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f5f3ef;
  color: #6b6355;
  font-size: 21rpx;
  font-weight: 700;
}

.difficulty-pill-inline {
  background: #fdf4f0;
  color: #a8432d;
}

.recipe-footer {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 18rpx;
  color: #8a8270;
  font-size: 23rpx;
}

.recipe-foot-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.recipe-foot-icon {
  width: 24rpx;
  height: 24rpx;
}

.empty-state {
  display: flex;
  min-height: 520rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 80rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border-radius: 44rpx;
  background: #f5f3ef;
}

.empty-icon-image {
  width: 74rpx;
  height: 74rpx;
}

.empty-title {
  margin-top: 52rpx;
  color: #524c40;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 16rpx;
  color: #8a8270;
  font-size: 27rpx;
}

.empty-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 230rpx;
  height: 84rpx;
  margin-top: 58rpx;
  border-radius: 999rpx;
  background: #c9583a;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(201, 88, 58, 0.18);
}

/* Select mode */
.select-button {
  background: #5a7a54;
  box-shadow: 0 10rpx 28rpx rgba(90, 122, 84, 0.22);
}

.cancel-button {
  background: #f5f3ef;
  color: #8a8270;
}

.select-check {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.2);
}

.select-check.is-selected {
  border-color: #5a7a54;
  background: #5a7a54;
}

.select-check-icon {
  width: 24rpx;
  height: 24rpx;
}

.in-select {
  opacity: 0.85;
}

/* Bottom select bar */
.select-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 120rpx;
  padding: 0 44rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgba(37, 34, 32, 0.08);
}

.select-bar-info {
  color: #524c40;
  font-size: 28rpx;
  font-weight: 700;
}

.select-bar-count {
  color: #c9583a;
}

.select-bar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 78rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #c9583a;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(201, 88, 58, 0.2);
}

.select-bar-icon {
  width: 32rpx;
  height: 32rpx;
}
