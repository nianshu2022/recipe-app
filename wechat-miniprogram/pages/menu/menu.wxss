.menu-page {
  padding: 36rpx 44rpx 180rpx;
}

.page-heading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 0 52rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(37, 34, 32, 0.06);
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.heading-copy {
  flex: 1;
  min-width: 0;
}

.title {
  color: #252220;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.15;
}

.subtitle {
  margin-top: 14rpx;
  color: #6b6355;
  font-size: 27rpx;
  line-height: 1.7;
}

.add-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #c9583a;
  box-shadow: 0 10rpx 24rpx rgba(201, 88, 58, 0.2);
}

.add-icon {
  width: 34rpx;
  height: 34rpx;
}

/* Menu list */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.menu-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  border-radius: 18rpx;
  color: #ffffff;
}

.menu-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.menu-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.24);
}

.menu-cover-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.72;
  filter: brightness(0) invert(1);
}

.menu-body {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
  text-align: left;
}

.menu-name {
  overflow: hidden;
  color: #252220;
  font-size: 31rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-count {
  margin-top: 8rpx;
  color: #8a8270;
  font-size: 24rpx;
}

.menu-actions {
  display: flex;
  gap: 12rpx;
}

.menu-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f5f3ef;
}

.menu-action-btn.delete {
  background: #fff7f5;
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
}

/* Recipe list in detail view */
.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.recipe-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.recipe-main {
  display: flex;
  flex: 1;
  min-width: 0;
  text-align: left;
}

.recipe-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  border-radius: 18rpx;
  color: #ffffff;
}

.recipe-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.recipe-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.24);
}

.recipe-cover-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.72;
  filter: brightness(0) invert(1);
}

.recipe-body {
  min-width: 0;
  flex: 1;
  padding: 6rpx 0 0 20rpx;
}

.recipe-name {
  overflow: hidden;
  color: #252220;
  font-size: 31rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.mini-pill {
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #f5f3ef;
  color: #6b6355;
  font-size: 21rpx;
  font-weight: 700;
}

.recipe-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  color: #8a8270;
  font-size: 24rpx;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
}

.remove-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f5f3ef;
}

.remove-icon {
  width: 26rpx;
  height: 26rpx;
}

/* Detail actions */
.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.detail-action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 120rpx;
  border-radius: 22rpx;
  background: #f9f8f6;
  color: #524c40;
  font-size: 22rpx;
  font-weight: 700;
}

.detail-action-icon {
  width: 36rpx;
  height: 36rpx;
}

/* Empty state */
.empty-icon {
  width: 74rpx;
  height: 74rpx;
}

.empty-title {
  margin-top: 44rpx;
  color: #524c40;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 18rpx;
  color: #8a8270;
  font-size: 27rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 84rpx;
  margin-top: 58rpx;
  margin-left: auto;
  margin-right: auto;
  line-height: 84rpx;
  padding: 0;
}

/* Popup styles */
.edit-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.35);
}

.edit-popup {
  width: 560rpx;
  padding: 48rpx 40rpx 36rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(37, 34, 32, 0.18);
}

.edit-title {
  margin-bottom: 28rpx;
  color: #252220;
  font-size: 32rpx;
  font-weight: 800;
  text-align: center;
}

.edit-input {
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e8e4de;
  border-radius: 20rpx;
  background: #faf9f7;
  color: #252220;
  font-size: 30rpx;
  text-align: center;
}

.placeholder {
  color: #a8a08e;
}

.edit-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.edit-cancel {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 20rpx;
  background: #f5f3ef;
  color: #6b6355;
  font-size: 28rpx;
  font-weight: 700;
}

.edit-confirm {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  border-radius: 20rpx;
  background: #c9583a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

/* Recipe picker */
.recipe-picker {
  width: 100%;
  max-height: 70vh;
  padding: 36rpx 44rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 40rpx rgba(37, 34, 32, 0.12);
  align-self: flex-end;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.picker-title {
  color: #252220;
  font-size: 32rpx;
  font-weight: 800;
}

.picker-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f5f3ef;
}

.close-icon {
  width: 28rpx;
  height: 28rpx;
}

.picker-list {
  max-height: 50vh;
  overflow-y: auto;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f3ef;
}

.picker-item:last-child {
  border-bottom: 0;
}

.picker-item-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 16rpx;
  color: #ffffff;
}

.picker-item-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.picker-item-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.72;
  filter: brightness(0) invert(1);
}

.picker-item-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.picker-item-name {
  overflow: hidden;
  color: #252220;
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-item-meta {
  margin-top: 6rpx;
  color: #a8a08e;
  font-size: 22rpx;
}

.picker-empty {
  padding: 48rpx 0;
  color: #a8a08e;
  font-size: 26rpx;
  text-align: center;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 999rpx;
  background: #c9583a;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(201, 88, 58, 0.18);
}
