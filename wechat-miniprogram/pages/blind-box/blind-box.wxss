.blind-page {
  padding: 36rpx 44rpx 180rpx;
}

.page-heading {
  padding: 12rpx 4rpx 28rpx;
}

.title {
  color: #252220;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.15;
}

.subtitle {
  margin-top: 14rpx;
  color: #6b6355;
  font-size: 27rpx;
  line-height: 1.7;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  padding: 80rpx 28rpx;
  text-align: center;
}

.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 44rpx;
  border-radius: 48rpx;
  background: #f5f3ef;
}

.empty-icon {
  width: 72rpx;
  height: 72rpx;
}

.empty-title {
  color: #252220;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 16rpx;
  color: #8a8270;
  font-size: 26rpx;
}

.empty-action {
  width: 240rpx;
  margin-top: 32rpx;
}

.box-card {
  display: flex;
  min-height: 560rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  padding: 34rpx;
}

.box-card.is-shaking {
  animation: shake 0.65s ease-in-out;
}

.box-face {
  text-align: center;
}

.box-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 34rpx;
  background: #fdf4f0;
  border-radius: 48rpx;
  border: 2rpx solid #e8c0b1;
}

.box-icon-image {
  width: 88rpx;
  height: 88rpx;
}

.sparkle-icon {
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 16rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #c49a3c;
}

.box-title {
  color: #252220;
  font-size: 34rpx;
  font-weight: 800;
}

.box-desc {
  margin-top: 8rpx;
  color: #8a8270;
  font-size: 25rpx;
}

.result-face {
  width: 100%;
}

.result-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 220rpx;
  border-radius: 24rpx;
  color: #ffffff;
}

.result-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.result-cover-icon {
  width: 88rpx;
  height: 88rpx;
  opacity: 0.78;
  filter: brightness(0) invert(1);
}

.result-content {
  padding-top: 28rpx;
}

.result-name {
  color: #252220;
  font-size: 42rpx;
  font-weight: 800;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.result-pill {
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f3ef;
  color: #6b6355;
  font-size: 22rpx;
  font-weight: 750;
}

.result-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 22rpx;
  margin-top: 20rpx;
  color: #8a8270;
  font-size: 24rpx;
}

.result-meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.result-meta-icon {
  width: 24rpx;
  height: 24rpx;
}

.redraw-button {
  margin-top: 18rpx;
}

.icon-action {
  gap: 12rpx;
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
}
