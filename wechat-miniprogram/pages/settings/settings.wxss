.settings-page {
  padding: 36rpx 44rpx 180rpx;
}

.settings-title {
  margin-bottom: 86rpx;
  color: #252220;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.05;
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 38rpx;
  border: 0;
  border-radius: 34rpx;
  box-shadow: none;
}

.avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin-right: 28rpx;
  border-radius: 32rpx;
  background: #f5f3ef;
}

.avatar-icon {
  width: 52rpx;
  height: 52rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.name {
  color: #252220;
  font-size: 32rpx;
  font-weight: 800;
}

.desc {
  margin-top: 6rpx;
  color: #8a8270;
  font-size: 25rpx;
}

.sync-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #faf9f7;
}

.sync-icon {
  width: 34rpx;
  height: 34rpx;
}

.sync-icon.is-syncing {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.group-title {
  margin: 32rpx 0 16rpx;
  color: #a8a08e;
  font-size: 24rpx;
  font-weight: 700;
}

.theme-card {
  display: flex;
  padding: 6rpx;
  border: 0;
  border-radius: 999rpx;
  box-shadow: none;
}

.theme-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  color: #524c40;
  font-size: 25rpx;
  font-weight: 700;
}

.theme-option.active {
  background: #c9583a;
  color: #ffffff;
}

.theme-option.active .theme-icon {
  filter: brightness(0) invert(1);
}

.theme-icon {
  width: 24rpx;
  height: 24rpx;
}

.action-list {
  overflow: hidden;
  margin-top: 0;
  border: 0;
  border-radius: 24rpx;
  box-shadow: none;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 34rpx;
  border-bottom: 1rpx solid #f5f3ef;
  color: #252220;
  font-size: 29rpx;
  font-weight: 650;
  text-align: left;
}

.action-row:last-child {
  border-bottom: 0;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-icon {
  width: 32rpx;
  height: 32rpx;
}

.chevron {
  width: 28rpx;
  height: 28rpx;
}

.logout-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 84rpx;
  margin-top: 34rpx;
  border-radius: 28rpx;
  background: #ffffff;
  color: #c44b4b;
  font-size: 27rpx;
  font-weight: 800;
}

.logout-icon {
  width: 32rpx;
  height: 32rpx;
}

.about {
  margin-top: 70rpx;
  text-align: center;
  color: #a8a08e;
  font-size: 23rpx;
  line-height: 1.9;
}

.about-links {
  margin-top: 14rpx;
  color: #c9583a;
}

.link-gap {
  display: inline-block;
  width: 32rpx;
  color: transparent;
}

.settings-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--color-bg, #faf9f7);
  overflow-y: auto;
}

.panel-header {
  position: sticky;
  top: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 44rpx;
  background: rgba(250, 249, 247, 0.95);
  backdrop-filter: blur(20rpx);
  z-index: 10;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(37, 34, 32, 0.06);
}

.back-button:active {
  transform: scale(0.95);
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.panel-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #252220;
}

.panel-content {
  padding: 20rpx 44rpx 180rpx;
}
