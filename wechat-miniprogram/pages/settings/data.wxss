.data-page {
  padding: 28rpx 44rpx 180rpx;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: -28rpx -44rpx 34rpx;
  padding: 0 44rpx 10rpx;
  background: rgba(250, 249, 247, 0.96);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(37, 34, 32, 0.06);
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.title {
  color: #252220;
  font-size: 44rpx;
  font-weight: 800;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.stat-card {
  padding: 24rpx 8rpx;
  text-align: center;
}

.stat-value {
  color: #252220;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.1;
}

.stat-label {
  margin-top: 8rpx;
  color: #8a8270;
  font-size: 22rpx;
}

.group-title {
  margin: 48rpx 0 18rpx;
  color: #a8a08e;
  font-size: 24rpx;
  font-weight: 700;
}

.action-list {
  overflow: hidden;
  border: 0;
  box-shadow: none;
}

.action-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 112rpx;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f5f3ef;
  text-align: left;
}

.action-row:last-child {
  border-bottom: 0;
}

.row-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 22rpx;
}

.row-copy {
  flex: 1;
}

.row-title {
  color: #252220;
  font-size: 28rpx;
  font-weight: 800;
}

.row-desc {
  margin-top: 4rpx;
  color: #8a8270;
  font-size: 23rpx;
}

.danger .row-title {
  color: #c44b4b;
}

.import-box {
  width: 100%;
  height: 220rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #e8e4de;
  border-radius: 22rpx;
  background: #ffffff;
  color: #252220;
  font-size: 25rpx;
  line-height: 1.55;
}

.placeholder {
  color: #a8a08e;
}

.import-button {
  margin-top: 18rpx;
}

.message {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #eaf4e7;
  color: #5a7a54;
  font-size: 25rpx;
}

.message.error {
  background: #fff7f5;
  color: #c44b4b;
}

.message-icon {
  width: 30rpx;
  height: 30rpx;
}
