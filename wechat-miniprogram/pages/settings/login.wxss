.login-page {
  padding: 28rpx 44rpx 180rpx;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: -28rpx -44rpx 44rpx;
  padding: 0 44rpx 10rpx;
  background: rgba(250, 249, 247, 0.96);
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(37, 34, 32, 0.06);
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.title {
  color: #252220;
  font-size: 44rpx;
  font-weight: 800;
}

.form-card {
  padding: 36rpx 28rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  margin-bottom: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e8e4de;
  border-radius: 22rpx;
  background: #faf9f7;
}

.field-icon {
  width: 34rpx;
  height: 34rpx;
}

.input {
  flex: 1;
  height: 88rpx;
  color: #252220;
  font-size: 28rpx;
}

.placeholder {
  color: #a8a08e;
}

.error-text {
  margin: 4rpx 0 22rpx;
  text-align: center;
  color: #c44b4b;
  font-size: 25rpx;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  background: #c9583a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 30rpx rgba(201, 88, 58, 0.18);
}

.submit-button.is-loading,
.submit-button[disabled] {
  opacity: 0.5;
}

.mode-button {
  margin: 30rpx auto 0;
  color: #8a8270;
  font-size: 26rpx;
}

.hint {
  margin-top: 42rpx;
  text-align: center;
  color: #a8a08e;
  font-size: 24rpx;
}
