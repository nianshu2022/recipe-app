.collection-page {
  padding: 36rpx 44rpx 180rpx;
}

.page-heading {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 0 0 52rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 72rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(37, 34, 32, 0.06);
}

.back-icon {
  width: 38rpx;
  height: 38rpx;
}

.heading-copy {
  flex: 1;
  min-width: 0;
}

.title {
  color: #252220;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.15;
}

.subtitle {
  margin-top: 14rpx;
  color: #6b6355;
  font-size: 27rpx;
  line-height: 1.7;
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.favorite-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.favorite-main {
  display: flex;
  flex: 1;
  min-width: 0;
  text-align: left;
}

.favorite-cover {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  flex: 0 0 132rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.favorite-cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.favorite-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.24);
}

.favorite-cover-icon {
  width: 46rpx;
  height: 46rpx;
  opacity: 0.72;
  filter: brightness(0) invert(1);
}

.favorite-body {
  min-width: 0;
  flex: 1;
  padding: 6rpx 0 0 20rpx;
}

.favorite-name {
  overflow: hidden;
  color: #252220;
  font-size: 31rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.favorite-meta,
.tag-line {
  margin-top: 8rpx;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.mini-pill {
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #f5f3ef;
  color: #6b6355;
  font-size: 21rpx;
  font-weight: 700;
}

.favorite-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #8a8270;
  font-size: 24rpx;
}

.meta-icon {
  width: 24rpx;
  height: 24rpx;
}

.remove-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #fff7f5;
}

.remove-icon {
  width: 32rpx;
  height: 32rpx;
}

.empty-icon {
  width: 74rpx;
  height: 74rpx;
}

.empty-title {
  margin-top: 44rpx;
  color: #524c40;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 18rpx;
  color: #8a8270;
  font-size: 27rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 300rpx;
  height: 84rpx;
  margin-top: 58rpx;
  margin-left: auto;
  margin-right: auto;
  line-height: 84rpx;
  padding: 0;
}
