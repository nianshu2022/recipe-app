<view class="page page-safe collection-page {{themeClass}}" style="padding-top: {{contentTopInset}}px;">
  <view class="page-heading">
    <view class="back-button" bindtap="back">
      <image class="back-icon" src="/assets/lucide/arrow-left.svg" mode="aspectFit" />
    </view>
    <view class="heading-copy">
      <view class="title">{{viewMode === 'detail' ? currentCollection.name : '我的收藏夹'}}</view>
      <view class="subtitle">{{viewMode === 'detail' ? recipes.length + ' 道菜谱' : (collections.length > 0 ? collections.length + ' 个收藏夹' : '收藏喜欢的菜谱')}}</view>
    </view>
    <view wx:if="{{viewMode === 'list'}}" class="add-button" bindtap="showCreate">
      <image class="add-icon" src="/assets/lucide/plus-white.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- Collections list view -->
  <view wx:if="{{viewMode === 'list'}}">
    <view wx:if="{{collections.length > 0}}" class="collection-list">
      <view wx:for="{{collections}}" wx:key="id" class="collection-card card" data-id="{{item.id}}" bindtap="openCollection">
        <view class="collection-cover" style="background: {{item.coverColor}};">
          <image wx:if="{{item.coverImage}}" class="collection-cover-image" src="{{item.coverImage}}" mode="aspectFill" />
          <view wx:else class="collection-cover-placeholder">
            <image class="collection-cover-icon" src="{{item.categoryIcon}}" mode="aspectFit" />
          </view>
        </view>
        <view class="collection-body">
          <view class="collection-name">{{item.name}}</view>
          <view class="collection-count">{{item.recipeCount}} 道菜谱</view>
        </view>
        <view class="collection-actions" catchtap="noop">
          <view class="collection-action-btn" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="startRename">
            <image class="action-icon" src="/assets/lucide/pencil.svg" mode="aspectFit" />
          </view>
          <view class="collection-action-btn delete" data-id="{{item.id}}" catchtap="deleteCollection">
            <image class="action-icon" src="/assets/lucide/trash-2.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="card empty">
      <image class="empty-icon" src="/assets/lucide/heart.svg" mode="aspectFit" />
      <view class="empty-title">还没有收藏夹</view>
      <view class="empty-text">创建收藏夹来分类管理你的菜谱</view>
      <button class="primary-button empty-action" bindtap="showCreate">创建收藏夹</button>
    </view>
  </view>

  <!-- Collection detail view -->
  <view wx:if="{{viewMode === 'detail'}}">
    <view wx:if="{{recipes.length > 0}}" class="recipe-list">
      <view wx:for="{{recipes}}" wx:key="id" class="recipe-card card">
        <view class="recipe-main" data-id="{{item.id}}" bindtap="openRecipe">
          <view class="recipe-cover" style="background: {{item.coverColor}};">
            <image wx:if="{{item.coverImage}}" class="recipe-cover-image" src="{{item.coverImage}}" mode="aspectFill" />
            <view wx:else class="recipe-cover-placeholder">
              <image class="recipe-cover-icon" src="{{item.categoryIcon}}" mode="aspectFit" />
            </view>
          </view>
          <view class="recipe-body">
            <view class="recipe-name">{{item.name}}</view>
            <view class="tag-line">
              <text class="mini-pill">{{item.difficultyName}}</text>
              <text wx:for="{{item.displayTags}}" wx:for-item="tag" wx:key="*this" class="mini-pill">{{tag}}</text>
            </view>
            <view class="recipe-meta">
              <image class="meta-icon" src="/assets/lucide/clock.svg" mode="aspectFit" />
              <text>{{item.durationText}}</text>
              <text>{{item.servings}} 人份</text>
            </view>
          </view>
        </view>
        <view class="remove-button" data-id="{{item.id}}" bindtap="removeFavorite">
          <image class="remove-icon" src="/assets/lucide/x.svg" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view wx:else class="card empty">
      <image class="empty-icon" src="/assets/lucide/heart.svg" mode="aspectFit" />
      <view class="empty-title">收藏夹是空的</view>
      <view class="empty-text">浏览菜谱时可以将喜欢的菜谱添加到收藏夹</view>
      <button class="primary-button empty-action" bindtap="goHome">去逛逛</button>
    </view>
  </view>

  <!-- Create popup -->
  <view wx:if="{{showCreatePopup}}" class="edit-overlay" bindtap="hideCreate">
    <view class="edit-popup" catchtap="noop">
      <view class="edit-title">新建收藏夹</view>
      <input
        class="edit-input"
        value="{{newCollectionName}}"
        bindinput="onNewNameInput"
        placeholder="如：周末大餐、快手早餐"
        placeholder-class="placeholder"
        confirm-type="done"
        bindconfirm="confirmCreate"
        focus
      />
      <view class="edit-actions">
        <view class="edit-cancel" bindtap="hideCreate">取消</view>
        <view class="edit-confirm" bindtap="confirmCreate">创建</view>
      </view>
    </view>
  </view>

  <!-- Rename popup -->
  <view wx:if="{{showRenamePopup}}" class="edit-overlay" bindtap="hideRename">
    <view class="edit-popup" catchtap="noop">
      <view class="edit-title">重命名收藏夹</view>
      <input
        class="edit-input"
        value="{{renamingName}}"
        bindinput="onRenamingNameInput"
        placeholder="输入收藏夹名称"
        placeholder-class="placeholder"
        confirm-type="done"
        bindconfirm="confirmRename"
        focus
      />
      <view class="edit-actions">
        <view class="edit-cancel" bindtap="hideRename">取消</view>
        <view class="edit-confirm" bindtap="confirmRename">确定</view>
      </view>
    </view>
  </view>
</view>
<app-tabbar active="collection" />
