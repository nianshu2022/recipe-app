.plan-page {
  padding: 0 44rpx 180rpx;
}

.plan-topbar {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: -28rpx -44rpx 26rpx;
  padding: calc(28rpx + env(safe-area-inset-top)) 44rpx 22rpx;
  background: rgba(250, 249, 247, 0.95);
}

.topbar-copy {
  min-width: 0;
}

.title {
  color: #252220;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
}

.subtitle {
  margin-top: 14rpx;
  color: #6b6355;
  font-size: 27rpx;
  line-height: 1.7;
}

.topbar-actions {
  display: flex;
  gap: 12rpx;
}

.tool-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(37, 34, 32, 0.06);
}

.tool-icon {
  width: 34rpx;
  height: 34rpx;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card {
  padding: 28rpx 30rpx 32rpx;
  border: 0;
  border-radius: 34rpx;
  box-shadow: none;
}

.day-head {
  margin-bottom: 22rpx;
}

.day-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.day-name {
  color: #252220;
  font-size: 29rpx;
  font-weight: 800;
}

.day-name.is-today {
  color: #c9583a;
}

.day-date {
  color: #a8a08e;
  font-size: 24rpx;
}

.today-badge {
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  background: #fdf4f0;
  color: #c9583a;
  font-size: 20rpx;
  font-weight: 800;
}

.slot-row {
  display: inline-flex;
  width: calc(50% - 10rpx);
  min-height: 120rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  margin: 0 20rpx 16rpx 0;
  padding: 18rpx 20rpx;
  border: 1rpx dashed #ded8cf;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: left;
}

.slot-breakfast:not(.is-empty) {
  border-color: #f0d7a2;
  background: #fff8e8;
}

.slot-lunch:not(.is-empty) {
  border-color: #c9ddc0;
  background: #eef7ec;
}

.slot-dinner:not(.is-empty) {
  border-color: #c6dce0;
  background: #eef7f8;
}

.slot-snack:not(.is-empty) {
  border-color: #decadf;
  background: #f7eef8;
}

.slot-row:nth-child(2n + 1) {
  margin-right: 0;
}

.slot-label {
  color: #8a8270;
  font-size: 22rpx;
}

.slot-value {
  display: block;
  color: #8a8270;
  font-size: 25rpx;
  font-weight: 500;
}

.slot-empty {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}

.slot-plus {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.55;
}

.slot-row.is-empty .slot-value {
  color: #a8a08e;
  font-weight: 500;
}

.slot-content {
  width: 100%;
  min-width: 0;
  text-align: left;
}

.meal-chip-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 10rpx;
  margin-top: 10rpx;
}

.meal-chip {
  display: inline-flex;
  align-items: center;
  max-width: 260rpx;
  min-height: 46rpx;
  padding: 0 8rpx 0 18rpx;
  border-radius: 999rpx;
  background: #fdf4f0;
  color: #a8432d;
  font-size: 24rpx;
  font-weight: 700;
}

.meal-chip text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-remove {
  width: 34rpx;
  height: 34rpx;
  margin-left: 8rpx;
}

.picker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 80;
  display: flex;
  align-items: flex-end;
  background: rgba(37, 34, 32, 0.28);
}

.picker-panel {
  display: flex;
  width: 100%;
  max-height: 76vh;
  flex-direction: column;
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 32rpx 34rpx 20rpx;
}

.picker-title {
  color: #252220;
  font-size: 31rpx;
  font-weight: 850;
}

.picker-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #f5f3ef;
}

.picker-close-icon {
  width: 30rpx;
  height: 30rpx;
}

.picker-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 78rpx;
  margin: 0 34rpx 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e8e4de;
  border-radius: 22rpx;
  background: #faf9f7;
}

.picker-search-icon {
  width: 30rpx;
  height: 30rpx;
}

.picker-search-input {
  flex: 1;
  height: 78rpx;
  color: #252220;
  font-size: 26rpx;
}

.picker-placeholder {
  color: #a8a08e;
}

.picker-category-scroll {
  width: 100%;
  white-space: nowrap;
}

.picker-category-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 34rpx 18rpx;
}

.picker-category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f5f3ef;
  color: #524c40;
  font-size: 23rpx;
  font-weight: 750;
}

.picker-category-icon {
  width: 24rpx;
  height: 24rpx;
}

.picker-category.active {
  background: #c9583a;
  color: #ffffff;
}

.picker-list {
  flex: 1;
  min-height: 220rpx;
  padding: 0 34rpx;
}

.picker-recipe {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
}

.picker-recipe.is-selected {
  background: #fdf4f0;
}

.picker-recipe.is-disabled {
  opacity: 0.42;
}

.picker-recipe-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  flex: 0 0 74rpx;
  border-radius: 20rpx;
  background: #f5f3ef;
  color: #8a8270;
  font-size: 28rpx;
  font-weight: 850;
}

.picker-recipe.is-selected .picker-recipe-mark {
  background: #c9583a;
  color: #ffffff;
}

.picker-check {
  width: 34rpx;
  height: 34rpx;
}

.picker-recipe-copy {
  flex: 1;
  min-width: 0;
}

.picker-recipe-name {
  overflow: hidden;
  color: #252220;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-recipe-meta {
  margin-top: 4rpx;
  color: #8a8270;
  font-size: 23rpx;
}

.picker-empty {
  padding: 80rpx 0;
  color: #8a8270;
  font-size: 26rpx;
  text-align: center;
}

.picker-footer {
  padding: 22rpx 34rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f5f3ef;
}

.picker-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 26rpx;
  background: #c9583a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 850;
}

.picker-confirm.is-disabled {
  opacity: 0.42;
}
