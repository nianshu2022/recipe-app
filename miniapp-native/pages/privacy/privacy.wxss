.page { min-height: 100vh; background: var(--color-bg); padding: 32rpx; }
.title { font-size: 40rpx; font-weight: 700; color: var(--color-text); display: block; margin-bottom: 8rpx; }
.date { font-size: 22rpx; color: var(--color-text-muted); display: block; margin-bottom: 32rpx; }
.section { margin-bottom: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 12rpx; }
.text { font-size: 26rpx; color: var(--color-text-secondary); display: block; line-height: 1.6; }
.item { font-size: 26rpx; color: var(--color-text-secondary); display: block; line-height: 1.8; padding-left: 16rpx; }
