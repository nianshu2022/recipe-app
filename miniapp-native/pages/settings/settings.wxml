<view class="page">
  <!-- Profile card -->
  <view class="profile-card">
    <view class="avatar">
      <image src="/assets/icons/user.svg" class="avatar-icon" mode="aspectFit" />
    </view>
    <view class="profile-info">
      <text class="nickname">{{userInfo ? userInfo.nickname : '未登录'}}</text>
      <text class="user-email">{{userInfo ? userInfo.email : '登录后可同步数据到云端'}}</text>
    </view>
    <view class="login-btn" bindtap="{{userInfo ? 'onLogout' : 'onLogin'}}">
      {{userInfo ? '退出' : '登录'}}
    </view>
  </view>

  <!-- Menu: 我的内容 -->
  <view class="menu-group">
    <text class="menu-title">我的内容</text>
    <view class="menu-item" bindtap="onCollectionTap">
      <image src="/assets/icons/heart.svg" class="menu-icon" mode="aspectFit" />
      <text class="menu-text">我的收藏夹</text>
      <image src="/assets/icons/arrow-right.svg" class="menu-arrow" mode="aspectFit" />
    </view>
    <view class="menu-item" bindtap="onShoppingTap">
      <image src="/assets/icons/shopping-cart.svg" class="menu-icon" mode="aspectFit" />
      <text class="menu-text">购物清单</text>
      <image src="/assets/icons/arrow-right.svg" class="menu-arrow" mode="aspectFit" />
    </view>
  </view>

  <!-- Menu: 设置 -->
  <view class="menu-group">
    <text class="menu-title">设置</text>
    <view wx:if="{{!userInfo}}" class="menu-item" bindtap="onLogin">
      <image src="/assets/icons/lock.svg" class="menu-icon" mode="aspectFit" />
      <text class="menu-text">登录 / 注册</text>
      <image src="/assets/icons/arrow-right.svg" class="menu-arrow" mode="aspectFit" />
    </view>
    <view class="menu-item" bindtap="onDataManageTap">
      <image src="/assets/icons/database.svg" class="menu-icon" mode="aspectFit" />
      <text class="menu-text">数据管理</text>
      <image src="/assets/icons/arrow-right.svg" class="menu-arrow" mode="aspectFit" />
    </view>
  </view>

  <!-- Logout -->
  <view wx:if="{{userInfo}}" class="logout-btn" bindtap="onLogout">
    <image src="/assets/icons/log-out.svg" class="logout-icon" mode="aspectFit" />
    <text>退出登录</text>
  </view>

  <!-- About -->
  <view class="about">
    <text class="about-version">知味 v{{version}}</text>
    <text class="about-desc">你的私人美食管家</text>
    <view class="about-links">
      <text class="about-link" bindtap="onAbout">关于</text>
      <text class="about-link" bindtap="onPrivacyTap">隐私政策</text>
    </view>
  </view>
</view>
