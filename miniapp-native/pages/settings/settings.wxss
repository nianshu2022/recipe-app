.page { min-height: 100vh; background: var(--color-bg); padding: 0 32rpx 140rpx; }

/* Profile */
.profile-card { display: flex; align-items: center; gap: 20rpx; padding: 32rpx; background: var(--color-bg-card); border-radius: 24rpx; margin-top: 16rpx; box-shadow: var(--shadow-xs); }
.avatar { width: 88rpx; height: 88rpx; border-radius: 24rpx; background: linear-gradient(135deg, var(--color-bg-subtle), var(--color-bg)); display: flex; align-items: center; justify-content: center; }
.avatar-text { font-size: 36rpx; font-weight: 600; color: var(--color-text-muted); }
.profile-info { flex: 1; }
.nickname { font-size: 28rpx; font-weight: 600; color: var(--color-text); display: block; }
.user-email { font-size: 22rpx; color: var(--color-text-muted); display: block; margin-top: 4rpx; }
.login-btn { padding: 10rpx 28rpx; background: var(--color-bg); border-radius: 999rpx; font-size: 22rpx; color: var(--color-text-secondary); }
.login-btn:active { background: var(--color-bg-subtle); }

/* Menu groups */
.menu-group { margin-top: 24rpx; background: var(--color-bg-card); border-radius: 24rpx; overflow: hidden; box-shadow: var(--shadow-xs); }
.menu-title { font-size: 20rpx; font-weight: 600; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 1rpx; display: block; padding: 20rpx 28rpx 8rpx; }
.menu-item { display: flex; align-items: center; padding: 24rpx 28rpx; border-top: 1rpx solid var(--color-border-subtle); }
.menu-item:active { background: var(--color-bg-subtle); }
.menu-icon { font-size: 28rpx; margin-right: 20rpx; width: 40rpx; text-align: center; }
.menu-text { flex: 1; font-size: 28rpx; font-weight: 500; color: var(--color-text); }
.menu-arrow { font-size: 28rpx; color: var(--color-text-muted); }

/* Logout */
.logout-btn { margin-top: 24rpx; background: var(--color-bg-card); border-radius: 24rpx; padding: 28rpx; text-align: center; font-size: 28rpx; font-weight: 500; color: #ef4444; box-shadow: var(--shadow-xs); }
.logout-btn:active { background: #fef2f2; }

/* About */
.about { text-align: center; padding: 48rpx 0 24rpx; }
.about-version { font-size: 22rpx; color: var(--color-text-muted); display: block; }
.about-desc { font-size: 22rpx; color: var(--color-text-muted); display: block; margin-top: 4rpx; }
.about-links { display: flex; justify-content: center; gap: 32rpx; margin-top: 20rpx; }
.about-link { font-size: 22rpx; color: var(--color-primary); }
.about-link:active { text-decoration: underline; }
