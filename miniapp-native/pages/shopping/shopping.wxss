.page { min-height: 100vh; background: var(--color-bg); padding: 0 32rpx 140rpx; }

.header { display: flex; justify-content: space-between; align-items: flex-end; padding: 24rpx 0; }
.header-title { font-size: 48rpx; font-weight: 700; color: var(--color-text); display: block; }
.header-sub { font-size: 22rpx; color: var(--color-text-muted); display: block; margin-top: 4rpx; }
.header-right { display: flex; gap: 12rpx; }
.header-btn { width: 72rpx; height: 72rpx; border-radius: 20rpx; background: var(--color-bg-card); display: flex; align-items: center; justify-content: center; font-size: 28rpx; box-shadow: var(--shadow-xs); }
.header-btn.primary { background: var(--color-primary); }
.header-btn.primary::after { content: ''; }
.header-btn:active { transform: scale(0.95); }

.add-bar { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.add-input { flex: 1; height: 72rpx; padding: 0 24rpx; background: var(--color-bg-card); border-radius: 16rpx; font-size: 26rpx; border: 1rpx solid var(--color-border); }
.add-confirm { height: 72rpx; padding: 0 24rpx; background: var(--color-primary); color: #fff; border-radius: 16rpx; display: flex; align-items: center; font-size: 26rpx; font-weight: 600; }
.add-cancel { width: 72rpx; height: 72rpx; background: var(--color-bg-card); border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--color-text-muted); }

.progress-wrap { margin-bottom: 20rpx; }
.progress-track { height: 8rpx; background: var(--color-bg-subtle); border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #10b981; border-radius: 4rpx; transition: width 0.5s; }

.groups { display: flex; flex-direction: column; gap: 16rpx; }
.group { background: var(--color-bg-card); border-radius: 24rpx; overflow: hidden; box-shadow: var(--shadow-xs); }
.group-header { display: flex; align-items: center; padding: 20rpx 28rpx; }
.group-name { font-size: 26rpx; font-weight: 600; color: var(--color-text); }
.group-count { font-size: 20rpx; padding: 2rpx 12rpx; background: var(--color-bg-subtle); border-radius: 999rpx; color: var(--color-text-secondary); margin-left: 12rpx; }
.group-arrow { margin-left: auto; font-size: 24rpx; color: var(--color-text-muted); }

.group-items { border-top: 1rpx solid var(--color-border-subtle); }
.item { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 28rpx; }
.item.checked { background: var(--color-bg-subtle); }
.checkbox { width: 40rpx; height: 40rpx; border-radius: 8rpx; border: 2rpx solid var(--color-border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.item.checked .checkbox { background: #10b981; border-color: #10b981; }
.check-icon { font-size: 22rpx; color: #fff; }
.item-name { flex: 1; font-size: 26rpx; color: var(--color-text); }
.item.checked .item-name { text-decoration: line-through; color: var(--color-text-muted); }
.item-amount { font-size: 22rpx; color: var(--color-text-muted); }
.item-delete { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: var(--color-text-muted); opacity: 0; }
.item:active .item-delete { opacity: 1; }

.delete-list { text-align: center; padding: 24rpx; margin-top: 24rpx; font-size: 24rpx; color: var(--color-text-muted); }
.delete-list:active { color: #ef4444; }

/* Empty state */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 72rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); margin-bottom: 12rpx; }
.empty-desc { font-size: 24rpx; color: var(--color-text-muted); margin-bottom: 48rpx; }
.empty-btn { padding: 20rpx 64rpx; background: var(--color-primary); color: #fff; border-radius: 24rpx; font-size: 28rpx; font-weight: 600; text-decoration: none; }
