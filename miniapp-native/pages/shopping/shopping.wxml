<view class="page">
  <!-- Empty state -->
  <view wx:if="{{!list}}" class="empty-state">
    <image src="/assets/icons/shopping-cart.svg" class="empty-icon" mode="aspectFit" />
    <text class="empty-title">清单是空的</text>
    <text class="empty-desc">从菜谱生成一份购物清单吧</text>
    <navigator url="/pages/index/index" openType="switchTab" class="empty-btn">去选菜谱</navigator>
  </view>

  <block wx:if="{{list}}">
    <!-- Header -->
    <view class="header">
      <view class="header-left">
        <text class="header-title">购物清单</text>
        <text class="header-sub">{{checkedCount}}/{{totalCount}} 已购</text>
      </view>
      <view class="header-right">
        <view wx:if="{{checkedCount > 0}}" class="header-btn" bindtap="onClearChecked">
          <image src="/assets/icons/eraser.svg" class="header-icon" mode="aspectFit" />
        </view>
        <view class="header-btn primary" bindtap="onShowAdd">
          <image src="/assets/icons/plus.svg" class="header-icon white" mode="aspectFit" />
        </view>
      </view>
    </view>

    <!-- Add item -->
    <view wx:if="{{showAdd}}" class="add-bar">
      <input class="add-input" placeholder="输入食材名称" value="{{newName}}" bindinput="onNewNameInput" bindconfirm="onAddItem" focus />
      <view class="add-confirm" bindtap="onAddItem">添加</view>
      <view class="add-cancel" bindtap="onHideAdd">
        <image src="/assets/icons/x.svg" class="cancel-icon" mode="aspectFit" />
      </view>
    </view>

    <!-- Progress bar -->
    <view class="progress-wrap">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{progress}}%"></view>
      </view>
    </view>

    <!-- Grouped items -->
    <view class="groups">
      <view wx:for="{{categories}}" wx:key="*this" class="group">
        <view class="group-header" data-cat="{{item}}" bindtap="onToggleCat">
          <text class="group-name">{{item}}</text>
          <text class="group-count">{{grouped[item].length}}</text>
          <image src="/assets/icons/arrow-right.svg" class="group-arrow {{expandedCats[item] === false ? '' : 'rotated'}}" mode="aspectFit" />
        </view>
        <view wx:if="{{expandedCats[item] !== false}}" class="group-items">
          <view wx:for="{{grouped[item]}}" wx:for-item="gitem" wx:key="id" class="item {{gitem.checked ? 'checked' : ''}}">
            <view class="checkbox" data-id="{{gitem.id}}" bindtap="onToggleItem">
              <image wx:if="{{gitem.checked}}" src="/assets/icons/check.svg" class="check-icon" mode="aspectFit" />
            </view>
            <text class="item-name">{{gitem.name}}</text>
            <text class="item-amount">{{gitem.amount > 0 ? gitem.amount + gitem.unit : ''}}</text>
            <view class="item-delete" data-id="{{gitem.id}}" bindtap="onRemoveItem">
              <image src="/assets/icons/x.svg" class="delete-icon" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Delete list -->
    <view class="delete-list" bindtap="onDeleteList">
      <image src="/assets/icons/trash.svg" class="delete-list-icon" mode="aspectFit" />
      <text>删除清单</text>
    </view>
  </block>
</view>
