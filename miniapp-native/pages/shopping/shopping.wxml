<view class="page">
  <!-- 输入框 -->
  <view class="input-bar">
    <input 
      class="input" 
      placeholder="输入食材名称" 
      value="{{newItem}}" 
      bindinput="onInput"
      bindconfirm="onAdd"
    />
    <view class="add-btn" bindtap="onAdd">添加</view>
  </view>

  <!-- 列表 -->
  <view class="list">
    <view 
      wx:for="{{items}}" 
      wx:key="id"
      class="item {{item.checked ? 'checked' : ''}}"
    >
      <view class="checkbox" data-index="{{index}}" bindtap="onToggle">
        <view class="check-icon">{{item.checked ? '✓' : ''}}</view>
      </view>
      <text class="item-name">{{item.name}}</text>
      <view class="delete-btn" data-index="{{index}}" bindtap="onDelete">×</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{items.length === 0}}" class="empty-state">
    <text class="empty-text">购物清单为空</text>
    <text class="empty-sub">添加需要购买的食材</text>
  </view>

  <!-- 底部操作 -->
  <view wx:if="{{items.length > 0}}" class="footer">
    <view class="footer-text">{{items.length}} 项食材</view>
    <view class="clear-btn" bindtap="onClear">清除已购</view>
  </view>
</view>
