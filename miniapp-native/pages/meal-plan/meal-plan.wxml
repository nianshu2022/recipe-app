<view class="page">
  <view class="header">
    <text class="title">一周餐食计划</text>
    <text class="subtitle">规划你的美味一周</text>
  </view>

  <view class="plan-grid">
    <view wx:for="{{weekDays}}" wx:key="*this" wx:for-item="day" wx:for-index="dayIndex" class="day-column">
      <view class="day-header {{dayIndex === 0 ? 'today' : ''}}">{{day}}</view>
      <view 
        wx:for="{{mealSlots}}" 
        wx:key="*this" 
        wx:for-item="slot" 
        wx:for-index="slotIndex"
        class="meal-slot"
        data-day="{{dayIndex}}"
        data-slot="{{slotIndex}}"
        bindtap="onDaySlotTap"
      >
        <text class="slot-label">{{slot}}</text>
        <view class="slot-content">
          <text wx:if="{{currentPlan.days[dayIndex][slotIndex]}}" class="slot-text">
            {{currentPlan.days[dayIndex][slotIndex]}}
          </text>
          <text wx:else class="slot-empty">+</text>
        </view>
      </view>
    </view>
  </view>
</view>
