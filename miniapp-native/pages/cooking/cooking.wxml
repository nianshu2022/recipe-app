<view class="page" wx:if="{{recipe}}">
  <!-- Progress -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: {{(currentStep + 1) / totalSteps * 100}}%"></view>
  </view>

  <!-- Step info -->
  <view class="step-info">
    <text class="step-label">步骤 {{currentStep + 1}} / {{totalSteps}}</text>
  </view>

  <!-- Step content -->
  <view class="step-content">
    <text class="step-text">{{recipe.steps[currentStep].description}}</text>
    <view wx:if="{{recipe.steps[currentStep].timer}}" class="step-hint">
      <image src="/assets/icons/clock.svg" class="hint-icon" mode="aspectFit" />
      <text>建议时间：{{recipe.steps[currentStep].timer}}分钟</text>
    </view>
  </view>

  <!-- Timer -->
  <view class="timer-section">
    <text class="timer-text">{{timerText}}</text>
    <view class="timer-actions">
      <view class="timer-btn {{timerRunning ? 'active' : ''}}" bindtap="onToggleTimer">
        <image src="{{timerRunning ? '/assets/icons/pause.svg' : '/assets/icons/play.svg'}}" class="timer-icon" mode="aspectFit" />
        <text>{{timerRunning ? '暂停' : '开始'}}</text>
      </view>
      <view class="timer-btn" bindtap="onResetTimer">
        <image src="/assets/icons/rotate-ccw.svg" class="timer-icon" mode="aspectFit" />
        <text>重置</text>
      </view>
    </view>
  </view>

  <!-- Navigation -->
  <view class="nav-actions">
    <view class="btn btn-secondary {{currentStep === 0 ? 'disabled' : ''}}" bindtap="onPrevStep">
      <image src="/assets/icons/arrow-left.svg" class="btn-icon" mode="aspectFit" />
      <text>上一步</text>
    </view>
    <view wx:if="{{currentStep < totalSteps - 1}}" class="btn btn-primary" bindtap="onNextStep">
      <text>下一步</text>
      <image src="/assets/icons/arrow-right.svg" class="btn-icon white" mode="aspectFit" />
    </view>
    <view wx:else class="btn btn-primary" bindtap="onFinish">
      <image src="/assets/icons/check.svg" class="btn-icon white" mode="aspectFit" />
      <text>完成</text>
    </view>
  </view>
</view>
