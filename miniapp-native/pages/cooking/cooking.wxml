<view class="page" wx:if="{{recipe}}">
  <!-- Progress -->
  <view class="progress-bar">
    <view class="progress-fill" style="width: {{(currentStep + 1) / totalSteps * 100}}%"></view>
  </view>

  <!-- Step info -->
  <view class="step-info">
    <text class="step-label">步骤 {{currentStep + 1}} / {{totalSteps}}</text>
  </view>

  <!-- Step content -->
  <view class="step-content">
    <text class="step-text">{{recipe.steps[currentStep].description}}</text>
    <text wx:if="{{recipe.steps[currentStep].timer}}" class="step-hint">⏱ 建议时间：{{recipe.steps[currentStep].timer}}分钟</text>
  </view>

  <!-- Timer -->
  <view class="timer-section">
    <text class="timer-text">{{timerText}}</text>
    <view class="timer-actions">
      <view class="timer-btn {{timerRunning ? 'active' : ''}}" bindtap="onToggleTimer">
        {{timerRunning ? '⏸ 暂停' : '▶ 开始'}}
      </view>
      <view class="timer-btn" bindtap="onResetTimer">↺ 重置</view>
    </view>
  </view>

  <!-- Navigation -->
  <view class="nav-actions">
    <view class="btn btn-secondary {{currentStep === 0 ? 'disabled' : ''}}" bindtap="onPrevStep">上一步</view>
    <view wx:if="{{currentStep < totalSteps - 1}}" class="btn btn-primary" bindtap="onNextStep">下一步</view>
    <view wx:else class="btn btn-primary" bindtap="onFinish">完成 ✓</view>
  </view>
</view>
