.page {
  min-height: 100vh;
  background-color: #faf9f7;
  display: flex;
  flex-direction: column;
}

/* 进度条 */
.progress {
  height: 8rpx;
  background-color: #f5f3ef;
}

.progress-bar {
  height: 100%;
  background-color: #c9583a;
  transition: width 0.3s ease;
}

/* 步骤信息 */
.step-info {
  padding: 32rpx;
  text-align: center;
}

.step-label {
  font-size: 28rpx;
  color: #a8a08e;
}

/* 步骤内容 */
.step-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.step-text {
  font-size: 36rpx;
  color: #252220;
  line-height: 1.8;
  text-align: center;
}

/* 计时器 */
.timer {
  text-align: center;
  padding: 40rpx;
}

.timer-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #252220;
  font-variant-numeric: tabular-nums;
}

.timer-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 24rpx;
}

.timer-btn {
  padding: 16rpx 40rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #6b6355;
  border: 1rpx solid #e8e4de;
}

.timer-btn:active {
  background-color: #f5f3ef;
}

/* 导航按钮 */
.nav-buttons {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.nav-buttons .btn {
  flex: 1;
}
