<view class="page">
  <view class="header">
    <text class="title">味遇</text>
    <text class="subtitle">今天吃什么？让命运决定</text>
  </view>

  <view class="card-container">
    <view class="card {{isAnimating ? 'shaking' : ''}}" bindtap="onShake">
      <view class="card-cover">
        <view class="emoji">{{currentRecipe ? currentRecipe.name[0] : '?'}}</view>
      </view>
      <view class="card-info">
        <view class="recipe-name">{{currentRecipe ? currentRecipe.name : '摇一摇'}}</view>
        <view class="recipe-meta">
          <text>{{currentRecipe ? currentRecipe.category : ''}}</text>
          <text>{{currentRecipe ? currentRecipe.duration + '分钟' : ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="actions">
    <button class="btn btn-secondary" bindtap="onSkip">换一个</button>
    <button class="btn btn-primary" bindtap="onCook">就它了</button>
  </view>
</view>
