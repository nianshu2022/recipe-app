<view class="page">
  <!-- Header -->
  <view class="header">
    <text class="header-title">今天吃什么</text>
    <text class="header-sub">
      {{phase === 'idle' ? '让盲盒帮你决定' : phase === 'shaking' ? '正在抽取中...' : '盲盒揭晓！'}}
    </text>
  </view>

  <!-- No recipes state -->
  <view wx:if="{{!hasRecipes && phase === 'idle'}}" class="empty-state">
    <image src="/assets/icons/package.svg" class="empty-icon" mode="aspectFit" />
    <text class="empty-title">还没有菜谱</text>
    <text class="empty-desc">先去添加几道菜谱再来抽取</text>
    <view class="empty-actions">
      <view class="btn btn-primary" bindtap="onCreateRecipe">创建菜谱</view>
    </view>
  </view>

  <!-- Blind box card -->
  <view wx:if="{{hasRecipes || phase !== 'idle'}}" class="card-container">
    <!-- Front face -->
    <view wx:if="{{phase !== 'revealed'}}" class="blind-card {{phase === 'shaking' ? 'animate-shake' : ''}}">
      <view class="card-icon-wrap">
        <image src="/assets/icons/package.svg" class="card-icon" mode="aspectFit" />
      </view>
      <image src="/assets/icons/sparkles.svg" class="card-sparkle" mode="aspectFit" />
      <text class="card-text">
        {{phase === 'shaking' ? '摇一摇...' : '点击下方按钮抽取'}}
      </text>
      <text class="card-hint">
        共 {{hasRecipes ? '多' : '0'}} 道菜谱等待被抽中
      </text>
    </view>

    <!-- Back face -->
    <view wx:if="{{phase === 'revealed' && result}}" class="result-card">
      <view class="result-cover">
        <image wx:if="{{result.coverImage}}" src="{{result.coverImage}}" mode="aspectFill" class="result-img" />
        <view wx:else class="result-placeholder">
          <image src="{{result.categoryIcon}}" class="result-icon" mode="aspectFit" />
        </view>
      </view>
      <view class="result-info">
        <view class="result-header">
          <text class="result-name">{{result.name}}</text>
        </view>
        <view class="result-tags">
          <text class="tag {{result.difficultyColor}}">{{result.difficultyText}}</text>
          <text class="tag tag-default">{{result.categoryText}}</text>
          <text wx:for="{{result.tagsStr}}" wx:for-item="tag" wx:key="*this" class="tag tag-default">{{tag}}</text>
        </view>
        <view class="result-meta">
          <view class="meta-item">
            <image src="/assets/icons/clock.svg" class="meta-icon" mode="aspectFit" />
            <text>{{result.duration}}分钟</text>
          </view>
          <view class="meta-item">
            <image src="/assets/icons/users.svg" class="meta-icon" mode="aspectFit" />
            <text>{{result.servings}}人份</text>
          </view>
          <view class="meta-item">
            <image src="/assets/icons/utensils.svg" class="meta-icon" mode="aspectFit" />
            <text>{{result.ingredients.length}}种食材</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Action buttons -->
  <view class="actions">
    <block wx:if="{{phase === 'idle' && hasRecipes}}">
      <view class="btn btn-primary large" bindtap="onDraw">
        <image src="/assets/icons/package.svg" class="btn-icon white" mode="aspectFit" />
        <text>从我的菜谱抽取</text>
      </view>
    </block>

    <block wx:if="{{phase === 'revealed' && result}}">
      <view class="btn btn-primary large" bindtap="onViewDetail">
        <text>查看详情</text>
        <image src="/assets/icons/arrow-right.svg" class="btn-icon white" mode="aspectFit" />
      </view>
      <view class="btn btn-secondary" bindtap="onRedraw">
        <image src="/assets/icons/rotate-ccw.svg" class="btn-icon" mode="aspectFit" />
        <text>再抽一次</text>
      </view>
    </block>
  </view>
</view>
