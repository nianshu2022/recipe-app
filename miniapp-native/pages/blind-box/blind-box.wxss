.page { min-height: 100vh; background: var(--color-bg); display: flex; flex-direction: column; align-items: center; }

.header { text-align: center; padding: 60rpx 32rpx 40rpx; width: 100%; }
.header-title { font-size: 56rpx; font-weight: 700; color: var(--color-text); display: block; }
.header-sub { font-size: 26rpx; color: var(--color-text-muted); display: block; margin-top: 12rpx; }

.card-container { flex: 1; display: flex; align-items: center; justify-content: center; padding: 40rpx; width: 100%; }

.blind-card { width: 100%; max-width: 500rpx; background: linear-gradient(135deg, var(--color-accent-50), var(--color-bg-card)); border-radius: 32rpx; padding: 64rpx 48rpx; text-align: center; box-shadow: var(--shadow-md); min-height: 480rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.card-icon-wrap { width: 160rpx; height: 160rpx; border-radius: 32rpx; background: rgba(201,88,58,0.1); display: flex; align-items: center; justify-content: center; margin-bottom: 32rpx; }
.card-icon { width: 80rpx; height: 80rpx; opacity: 0.8; }
.card-sparkle { width: 40rpx; height: 40rpx; margin-bottom: 16rpx; opacity: 0.6; }
.card-text { font-size: 30rpx; font-weight: 500; color: var(--color-text); }
.card-hint { font-size: 22rpx; color: var(--color-text-muted); margin-top: 8rpx; }

.result-card { width: 100%; max-width: 500rpx; background: var(--color-bg-card); border-radius: 32rpx; overflow: hidden; box-shadow: var(--shadow-md); min-height: 480rpx; }
.result-cover { width: 100%; height: 240rpx; overflow: hidden; }
.result-img { width: 100%; height: 100%; }
.result-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent-400)); display: flex; align-items: center; justify-content: center; }
.result-icon { width: 80rpx; height: 80rpx; filter: brightness(0) invert(1); opacity: 0.8; }
.result-info { padding: 32rpx; }
.result-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.result-name { font-size: 36rpx; font-weight: 700; color: var(--color-text); }
.result-badge { font-size: 20rpx; padding: 4rpx 14rpx; background: #dbeafe; color: #2563eb; border-radius: 999rpx; }
.result-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 16rpx; }
.tag { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; font-weight: 500; }
.difficulty-easy { background: #ecfdf5; color: #065f46; }
.difficulty-medium { background: #fffbeb; color: #92400e; }
.difficulty-hard { background: #fef2f2; color: #991b1b; }
.tag-default { background: var(--color-bg-subtle); color: var(--color-text-secondary); }
.result-meta { display: flex; gap: 20rpx; font-size: 22rpx; color: var(--color-text-muted); }
.meta-item { display: flex; align-items: center; gap: 6rpx; }
.meta-icon { width: 24rpx; height: 24rpx; opacity: 0.6; }

.actions { width: 100%; padding: 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.btn { height: 88rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 28rpx; font-weight: 600; }
.btn:active { transform: scale(0.98); }
.btn.large { height: 96rpx; font-size: 30rpx; }
.btn-primary { background: var(--color-primary); color: #fff; box-shadow: 0 4px 12px rgba(201,88,58,0.3); }
.btn-secondary { background: var(--color-bg-card); color: var(--color-text-secondary); box-shadow: var(--shadow-xs); }
.btn-icon { width: 32rpx; height: 32rpx; }
.btn-icon.white { filter: brightness(0) invert(1); }

.empty-state { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; }
.empty-icon { width: 96rpx; height: 96rpx; margin-bottom: 24rpx; opacity: 0.3; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); margin-bottom: 12rpx; }
.empty-desc { font-size: 24rpx; color: var(--color-text-muted); margin-bottom: 40rpx; text-align: center; }
.empty-actions { display: flex; gap: 16rpx; width: 100%; }
.empty-actions .btn { flex: 1; }
