.page { min-height: 100vh; background: var(--color-bg); padding: 0 32rpx 140rpx; }

.header { padding: 24rpx 0; }
.header-title { font-size: 48rpx; font-weight: 700; color: var(--color-text); display: block; }
.header-sub { font-size: 24rpx; color: var(--color-text-muted); display: block; margin-top: 4rpx; }

.recipe-list { display: flex; flex-direction: column; gap: 16rpx; }
.recipe-card { display: flex; gap: 20rpx; padding: 20rpx; background: var(--color-bg-card); border-radius: 24rpx; box-shadow: var(--shadow-xs); position: relative; }
.recipe-card:active { transform: scale(0.98); }
.recipe-cover { width: 140rpx; height: 140rpx; border-radius: 20rpx; overflow: hidden; flex-shrink: 0; }
.cover-img { width: 100%; height: 100%; }
.cover-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-bg-subtle), var(--color-bg)); display: flex; align-items: center; justify-content: center; }
.cover-icon { width: 48rpx; height: 48rpx; opacity: 0.5; }
.recipe-info { flex: 1; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.recipe-name { font-size: 28rpx; font-weight: 600; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recipe-tags { display: flex; flex-wrap: wrap; gap: 6rpx; margin-top: 10rpx; }
.tag { font-size: 20rpx; padding: 3rpx 12rpx; border-radius: 999rpx; font-weight: 500; }
.difficulty-easy { background: #ecfdf5; color: #065f46; }
.difficulty-medium { background: #fffbeb; color: #92400e; }
.difficulty-hard { background: #fef2f2; color: #991b1b; }
.tag-default { background: var(--color-bg-subtle); color: var(--color-text-secondary); }
.recipe-meta { display: flex; gap: 16rpx; margin-top: 8rpx; font-size: 22rpx; color: var(--color-text-muted); }
.meta-item { display: flex; align-items: center; gap: 6rpx; }
.meta-icon { width: 24rpx; height: 24rpx; opacity: 0.6; }

.unfav-btn { position: absolute; top: 16rpx; right: 16rpx; width: 56rpx; height: 56rpx; border-radius: 50%; background: rgba(250,249,247,0.8); display: flex; align-items: center; justify-content: center; }
.unfav-icon { width: 28rpx; height: 28rpx; filter: invert(27%) sepia(51%) saturate(2878%) hue-rotate(346deg) brightness(104%) contrast(97%); }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { width: 96rpx; height: 96rpx; margin-bottom: 24rpx; opacity: 0.3; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); margin-bottom: 12rpx; }
.empty-desc { font-size: 24rpx; color: var(--color-text-muted); margin-bottom: 48rpx; text-align: center; }
.empty-btn { padding: 20rpx 64rpx; background: var(--color-primary); color: #fff; border-radius: 24rpx; font-size: 28rpx; font-weight: 600; text-decoration: none; }
