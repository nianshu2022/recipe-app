.page {
  min-height: 100vh;
  background-color: #faf9f7;
}

.list {
  padding: 20rpx 32rpx;
}

.item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1px 2px rgba(37, 34, 32, 0.04);
}

.item:active {
  transform: scale(0.98);
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f5f3ef, #e8e4de);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.emoji {
  font-size: 48rpx;
}

.info {
  flex: 1;
  margin-left: 24rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #252220;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: #a8a08e;
}

.remove-btn {
  padding: 12rpx 24rpx;
  background-color: #f5f3ef;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #6b6355;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #a8a08e;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #a8a08e;
}
