<view class="page">
  <!-- Header -->
  <view class="header">
    <text class="header-title">我的收藏</text>
    <text class="header-sub">{{recipes.length > 0 ? recipes.length + ' 道收藏' : '收藏喜欢的菜谱'}}</text>
  </view>

  <!-- Recipe list -->
  <view wx:if="{{recipes.length > 0}}" class="recipe-list">
    <view wx:for="{{recipes}}" wx:key="id" class="recipe-card" data-id="{{item.id}}" bindtap="onRecipeTap">
      <view class="recipe-cover">
        <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" class="cover-img" />
        <view wx:else class="cover-placeholder">
          <text class="cover-emoji">{{item.categoryIcon}}</text>
        </view>
      </view>
      <view class="recipe-info">
        <text class="recipe-name">{{item.name}}</text>
        <view class="recipe-tags">
          <text class="tag {{item.difficultyColor}}">{{item.difficultyText}}</text>
          <text wx:for="{{item.tagsStr}}" wx:for-item="tag" wx:key="*this" class="tag tag-default">{{tag}}</text>
        </view>
        <view class="recipe-meta">
          <text>⏱ {{item.duration}}分钟</text>
          <text>{{item.servings}}人份</text>
        </view>
      </view>
      <view class="unfav-btn" data-id="{{item.id}}" catchtap="onRemoveFavorite">
        <text class="heart-active">♥</text>
      </view>
    </view>
  </view>

  <!-- Empty state -->
  <view wx:if="{{!loading && recipes.length === 0}}" class="empty-state">
    <text class="empty-icon">♥</text>
    <text class="empty-title">还没有收藏</text>
    <text class="empty-desc">浏览菜谱时点击爱心，即可收藏喜欢的菜谱</text>
    <navigator url="/pages/index/index" openType="switchTab" class="empty-btn">去逛逛</navigator>
  </view>
</view>
