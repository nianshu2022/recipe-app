.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx 160rpx; }

.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 12rpx; }
.form-input { height: 80rpx; padding: 0 24rpx; background: var(--color-bg-card); border-radius: 16rpx; font-size: 28rpx; border: 1rpx solid var(--color-border); }
.form-picker { height: 80rpx; line-height: 80rpx; padding: 0 24rpx; background: var(--color-bg-card); border-radius: 16rpx; font-size: 28rpx; border: 1rpx solid var(--color-border); color: var(--color-text); }
.form-picker.small { height: 64rpx; line-height: 64rpx; font-size: 24rpx; min-width: 100rpx; text-align: center; padding: 0 16rpx; }
.form-textarea { width: 100%; min-height: 80rpx; padding: 16rpx 24rpx; background: var(--color-bg-card); border-radius: 16rpx; font-size: 28rpx; border: 1rpx solid var(--color-border); box-sizing: border-box; }

.form-row { display: flex; gap: 16rpx; }
.flex-1 { flex: 1; }
.flex-2 { flex: 2; }

.form-section { margin-bottom: 28rpx; }
.form-section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.add-btn { font-size: 24rpx; color: var(--color-primary); font-weight: 600; padding: 8rpx 16rpx; }

.ingredient-row { display: flex; gap: 12rpx; align-items: center; margin-bottom: 12rpx; }
.step-row { display: flex; gap: 12rpx; align-items: flex-start; margin-bottom: 12rpx; }
.step-num { width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--color-bg-subtle); display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: var(--color-text-secondary); flex-shrink: 0; margin-top: 16rpx; }
.remove-btn { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: var(--color-text-muted); flex-shrink: 0; }

.save-btn { position: fixed; bottom: 0; left: 0; right: 0; height: 96rpx; background: var(--color-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; }
.save-btn:active { opacity: 0.8; }
