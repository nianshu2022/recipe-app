<view class="page">
  <!-- Header -->
  <view class="header">
    <view class="header-left">
      <text class="header-title">寻味</text>
      <text class="header-sub">{{filteredRecipes.length > 0 ? filteredRecipes.length + ' 道拿手菜' : '记录你的拿手好菜'}}</text>
    </view>
    <view class="header-right">
      <view class="header-btn" bindtap="onBlindBoxTap">
        <image src="/assets/icons/sparkles.svg" class="header-icon" mode="aspectFit" />
      </view>
      <view class="header-btn primary" bindtap="onAddTap">
        <image src="/assets/icons/plus.svg" class="header-icon white" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Search -->
  <view class="search-bar">
    <image src="/assets/icons/search.svg" class="search-icon" mode="aspectFit" />
    <input class="search-input" placeholder="搜索菜谱、食材、标签..." value="{{searchKey}}" bindinput="onSearchInput" />
  </view>

  <!-- Category filters -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view class="filter-row">
      <view wx:for="{{categories}}" wx:key="value" 
        class="filter-tag {{categoryFilter === item.value ? 'active' : ''}}" 
        data-value="{{item.value}}" bindtap="onCategoryTap">
        <image wx:if="{{item.icon}}" src="{{item.icon}}" class="filter-icon" mode="aspectFit" />
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- Difficulty filters -->
  <view class="difficulty-row">
    <view wx:for="{{difficulties}}" wx:key="value"
      class="difficulty-tag {{difficultyFilter === item.value ? 'active' : ''}}"
      data-value="{{item.value}}" bindtap="onDifficultyTap">
      <text>{{item.label}}</text>
    </view>
  </view>

  <!-- Recipe list -->
  <view wx:if="{{!loading && filteredRecipes.length > 0}}" class="recipe-list">
    <view wx:for="{{filteredRecipes}}" wx:key="id" class="recipe-card" data-id="{{item.id}}" bindtap="onRecipeTap">
      <view class="recipe-cover">
        <image wx:if="{{item.coverImage}}" src="{{item.coverImage}}" mode="aspectFill" class="cover-img" />
        <view wx:else class="cover-placeholder">
          <image src="{{item.categoryIcon}}" class="cover-icon" mode="aspectFit" />
        </view>
      </view>
      <view class="recipe-info">
        <text class="recipe-name">{{item.name}}</text>
        <view class="recipe-tags">
          <text class="tag {{item.difficultyColor}}">{{item.difficultyText}}</text>
          <text wx:for="{{item.tagsStr}}" wx:for-item="tag" wx:key="*this" class="tag tag-default">{{tag}}</text>
        </view>
        <view class="recipe-meta">
          <view class="meta-item">
            <image src="/assets/icons/clock.svg" class="meta-icon" mode="aspectFit" />
            <text>{{item.duration}}分钟</text>
          </view>
          <view class="meta-item">
            <image src="/assets/icons/users.svg" class="meta-icon" mode="aspectFit" />
            <text>{{item.servings}}人份</text>
          </view>
        </view>
      </view>
      <view class="favorite-btn" data-id="{{item.id}}" catchtap="onToggleFavorite">
        <image src="{{item.isFavorited ? '/assets/icons/heart-filled.svg' : '/assets/icons/heart.svg'}}" class="heart-icon {{item.isFavorited ? 'active' : ''}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-card" wx:for="{{[1,2,3]}}" wx:key="*this">
      <view class="loading-cover"></view>
      <view class="loading-info">
        <view class="loading-line long"></view>
        <view class="loading-line short"></view>
        <view class="loading-line medium"></view>
      </view>
    </view>
  </view>

  <!-- Empty state -->
  <view wx:if="{{!loading && filteredRecipes.length === 0}}" class="empty-state">
    <image src="/assets/icons/utensils.svg" class="empty-icon" mode="aspectFit" />
    <text class="empty-title">还没有菜谱</text>
    <text class="empty-desc">快来创建你的第一道拿手菜吧</text>
    <view class="empty-btn" bindtap="onAddTap">创建菜谱</view>
  </view>
</view>
