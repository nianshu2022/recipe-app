.page { min-height: 100vh; background: var(--color-bg); padding: 24rpx 32rpx; }

.stats { display: flex; background: var(--color-bg-card); border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: var(--shadow-xs); }
.stat-item { flex: 1; text-align: center; }
.stat-value { font-size: 40rpx; font-weight: 700; color: var(--color-text); display: block; }
.stat-label { font-size: 22rpx; color: var(--color-text-muted); display: block; margin-top: 4rpx; }

.actions { background: var(--color-bg-card); border-radius: 24rpx; overflow: hidden; box-shadow: var(--shadow-xs); }
.action-item { display: flex; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--color-border-subtle); }
.action-item:last-child { border-bottom: none; }
.action-item:active { background: var(--color-bg-subtle); }
.action-item.danger .action-title { color: #ef4444; }
.action-icon { font-size: 36rpx; margin-right: 20rpx; }
.action-info { flex: 1; }
.action-title { font-size: 28rpx; font-weight: 600; color: var(--color-text); display: block; }
.action-desc { font-size: 22rpx; color: var(--color-text-muted); display: block; margin-top: 4rpx; }
