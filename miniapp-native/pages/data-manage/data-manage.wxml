<view class="page">
  <!-- Stats -->
  <view class="stats">
    <view class="stat-item">
      <text class="stat-value">{{recipesCount}}</text>
      <text class="stat-label">菜谱</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{collectionsCount}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{mealPlansCount}}</text>
      <text class="stat-label">餐食计划</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{shoppingListsCount}}</text>
      <text class="stat-label">购物清单</text>
    </view>
  </view>

  <!-- Actions -->
  <view class="actions">
    <view class="action-item" bindtap="onExport">
      <image src="/assets/icons/download.svg" class="action-icon" mode="aspectFit" />
      <view class="action-info">
        <text class="action-title">导出数据</text>
        <text class="action-desc">复制数据到剪贴板</text>
      </view>
    </view>
    <view class="action-item" bindtap="onImport">
      <image src="/assets/icons/arrow-right.svg" class="action-icon rotated" mode="aspectFit" />
      <view class="action-info">
        <text class="action-title">导入数据</text>
        <text class="action-desc">从剪贴板导入数据</text>
      </view>
    </view>
    <view class="action-item danger" bindtap="onClearAll">
      <image src="/assets/icons/trash.svg" class="action-icon red" mode="aspectFit" />
      <view class="action-info">
        <text class="action-title">清除所有数据</text>
        <text class="action-desc">删除所有本地数据</text>
      </view>
    </view>
  </view>
</view>
