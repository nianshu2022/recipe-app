<view class="page" wx:if="{{recipe}}">
  <!-- Header actions -->
  <view class="actions-bar">
    <view class="action-btn" bindtap="onEdit">
      <image src="/assets/icons/pencil.svg" class="action-icon" mode="aspectFit" />
    </view>
    <view class="action-btn" bindtap="onDelete">
      <image src="/assets/icons/trash.svg" class="action-icon red" mode="aspectFit" />
    </view>
    <view class="action-btn" bindtap="onToggleFavorite">
      <image src="{{isFavorited ? '/assets/icons/heart-filled.svg' : '/assets/icons/heart.svg'}}" class="action-icon {{isFavorited ? 'red' : ''}}" mode="aspectFit" />
    </view>
    <view class="action-btn" bindtap="onShare">
      <image src="/assets/icons/share.svg" class="action-icon" mode="aspectFit" />
    </view>
  </view>

  <!-- Cover -->
  <view class="cover-section">
    <image wx:if="{{recipe.coverImage}}" src="{{recipe.coverImage}}" mode="aspectFill" class="cover-img" />
    <view wx:else class="cover-placeholder">
      <image src="{{recipe.categoryIcon || '/assets/icons/utensils.svg'}}" class="cover-icon" mode="aspectFit" />
    </view>
  </view>

  <!-- Info -->
  <view class="info-section">
    <text class="recipe-name">{{recipe.name}}</text>
    <view class="recipe-tags">
      <text class="tag {{recipe.difficultyColor || 'difficulty-easy'}}">{{recipe.difficultyText || recipe.difficulty}}</text>
      <text class="tag tag-default">{{recipe.categoryText || recipe.category}}</text>
      <text wx:for="{{recipe.tags}}" wx:key="*this" class="tag tag-default">{{item}}</text>
    </view>
    <view class="recipe-meta">
      <view class="meta-item">
        <image src="/assets/icons/clock.svg" class="meta-icon" mode="aspectFit" />
        <text>{{recipe.duration}}分钟</text>
      </view>
      <view class="meta-item">
        <image src="/assets/icons/users.svg" class="meta-icon" mode="aspectFit" />
        <text>{{recipe.servings}}人份</text>
      </view>
      <view class="meta-item">
        <image src="/assets/icons/utensils.svg" class="meta-icon" mode="aspectFit" />
        <text>{{recipe.ingredients.length}}种食材</text>
      </view>
    </view>
  </view>

  <!-- Servings adjuster -->
  <view class="servings-section">
    <text class="section-label">调整份数</text>
    <view class="servings-control">
      <view class="servings-btn" data-delta="-1" bindtap="onServingsChange">
        <image src="/assets/icons/x.svg" class="btn-icon" mode="aspectFit" />
      </view>
      <text class="servings-value">{{servings}}</text>
      <view class="servings-btn" data-delta="1" bindtap="onServingsChange">
        <image src="/assets/icons/plus.svg" class="btn-icon" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- Ingredients -->
  <view class="section">
    <text class="section-title">食材</text>
    <view class="ingredient-list">
      <view wx:for="{{scaledIngredients}}" wx:key="name" class="ingredient-item">
        <text class="ingredient-name">{{item.name}}</text>
        <text class="ingredient-amount">{{item.amount}}{{item.unit}}</text>
      </view>
    </view>
  </view>

  <!-- Steps -->
  <view class="section">
    <text class="section-title">步骤</text>
    <view class="step-list">
      <view wx:for="{{recipe.steps}}" wx:key="order" class="step-item">
        <view class="step-number">{{item.order}}</view>
        <view class="step-content">
          <text class="step-text">{{item.description}}</text>
          <view wx:if="{{item.timer}}" class="step-timer">
            <image src="/assets/icons/clock.svg" class="timer-icon" mode="aspectFit" />
            <text>{{item.timer}}分钟</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Bottom actions -->
  <view class="bottom-actions">
    <view class="btn btn-secondary" bindtap="onAddToShopping">
      <image src="/assets/icons/shopping-cart.svg" class="btn-icon" mode="aspectFit" />
      <text>加入购物清单</text>
    </view>
    <view class="btn btn-primary" bindtap="onStartCooking">
      <image src="/assets/icons/play.svg" class="btn-icon white" mode="aspectFit" />
      <text>开始做菜</text>
    </view>
  </view>
</view>

<!-- Loading -->
<view wx:if="{{loading}}" class="loading-state">
  <view class="loading-card" wx:for="{{[1,2,3]}}" wx:key="*this">
    <view class="loading-line long"></view>
    <view class="loading-line medium"></view>
  </view>
</view>

<!-- Not found -->
<view wx:if="{{!loading && !recipe}}" class="empty-state">
  <image src="/assets/icons/utensils.svg" class="empty-icon" mode="aspectFit" />
  <text class="empty-title">菜谱不存在</text>
  <navigator url="/pages/index/index" openType="switchTab" class="empty-btn">返回首页</navigator>
</view>
