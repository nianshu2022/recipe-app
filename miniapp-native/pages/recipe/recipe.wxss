.page { min-height: 100vh; background: var(--color-bg); padding-bottom: 160rpx; }

/* Actions bar */
.actions-bar { display: flex; justify-content: flex-end; gap: 12rpx; padding: 16rpx 32rpx; }
.action-btn { width: 72rpx; height: 72rpx; border-radius: 20rpx; background: var(--color-bg-card); display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-xs); font-size: 28rpx; }
.action-btn:active { transform: scale(0.95); }
.text-red { color: #ef4444; }

/* Cover */
.cover-section { width: 100%; height: 400rpx; overflow: hidden; }
.cover-img { width: 100%; height: 100%; }
.cover-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-primary), var(--color-accent-400)); display: flex; align-items: center; justify-content: center; }
.cover-emoji { font-size: 120rpx; }

/* Info */
.info-section { padding: 32rpx; background: var(--color-bg-card); margin-bottom: 16rpx; }
.recipe-name { font-size: 44rpx; font-weight: 700; color: var(--color-text); display: block; }
.recipe-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.tag { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 999rpx; font-weight: 500; }
.difficulty-easy { background: #ecfdf5; color: #065f46; }
.difficulty-medium { background: #fffbeb; color: #92400e; }
.difficulty-hard { background: #fef2f2; color: #991b1b; }
.tag-default { background: var(--color-bg-subtle); color: var(--color-text-secondary); }
.recipe-meta { display: flex; gap: 24rpx; margin-top: 16rpx; font-size: 24rpx; color: var(--color-text-muted); }

/* Servings */
.servings-section { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; background: var(--color-bg-card); margin-bottom: 16rpx; }
.section-label { font-size: 28rpx; font-weight: 600; color: var(--color-text); }
.servings-control { display: flex; align-items: center; gap: 24rpx; }
.servings-btn { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--color-bg-subtle); display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: var(--color-text-secondary); }
.servings-btn:active { background: var(--color-border); }
.servings-value { font-size: 32rpx; font-weight: 600; color: var(--color-text); min-width: 48rpx; text-align: center; }

/* Sections */
.section { padding: 32rpx; background: var(--color-bg-card); margin-bottom: 16rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 24rpx; }

/* Ingredients */
.ingredient-list { display: flex; flex-direction: column; gap: 16rpx; }
.ingredient-item { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-border-subtle); }
.ingredient-item:last-child { border-bottom: none; }
.ingredient-name { font-size: 28rpx; color: var(--color-text); }
.ingredient-amount { font-size: 28rpx; color: var(--color-text-secondary); }

/* Steps */
.step-list { display: flex; flex-direction: column; gap: 24rpx; }
.step-item { display: flex; gap: 20rpx; }
.step-number { width: 48rpx; height: 48rpx; border-radius: 50%; background: var(--color-primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 600; flex-shrink: 0; }
.step-content { flex: 1; }
.step-text { font-size: 28rpx; color: var(--color-text); line-height: 1.6; }
.step-timer { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--color-primary); }

/* Bottom actions */
.bottom-actions { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; padding: 24rpx 32rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: var(--color-bg-card); border-top: 1rpx solid var(--color-border-subtle); }
.btn { flex: 1; height: 88rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.btn:active { transform: scale(0.98); }
.btn-secondary { background: var(--color-bg-card); color: var(--color-text); border: 1rpx solid var(--color-border); }
.btn-primary { background: var(--color-primary); color: #fff; }

/* Loading & Empty */
.loading-state { padding: 32rpx; display: flex; flex-direction: column; gap: 24rpx; }
.loading-card { background: var(--color-bg-card); border-radius: 24rpx; padding: 32rpx; }
.loading-line { height: 24rpx; background: var(--color-bg-subtle); border-radius: 8rpx; margin-bottom: 16rpx; }
.loading-line.long { width: 300rpx; }
.loading-line.medium { width: 200rpx; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 72rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); margin-bottom: 48rpx; }
.empty-btn { padding: 20rpx 64rpx; background: var(--color-primary); color: #fff; border-radius: 24rpx; font-size: 28rpx; font-weight: 600; text-decoration: none; }
