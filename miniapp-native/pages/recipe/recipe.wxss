.page {
  min-height: 100vh;
  background-color: #faf9f7;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background-color: #ffffff;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f5f3ef, #e8e4de);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.emoji {
  font-size: 80rpx;
}

.header-info {
  text-align: center;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #252220;
  margin-bottom: 16rpx;
}

.meta {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  font-size: 24rpx;
  color: #a8a08e;
}

/* 区块 */
.section {
  background-color: #ffffff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #252220;
  margin-bottom: 24rpx;
}

/* 食材列表 */
.ingredient-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f3ef;
}

.ingredient-name {
  font-size: 28rpx;
  color: #252220;
}

.ingredient-amount {
  font-size: 28rpx;
  color: #6b6355;
}

/* 步骤列表 */
.step-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #c9583a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.step-text {
  flex: 1;
  font-size: 28rpx;
  color: #252220;
  line-height: 1.6;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
}

.actions .btn {
  flex: 1;
}

/* 表单 */
.form {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #252220;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid #e8e4de;
}

.input.small {
  width: 120rpx;
  text-align: center;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid #e8e4de;
}

.form-section {
  margin-bottom: 32rpx;
}

.form-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.add-btn {
  font-size: 28rpx;
  color: #c9583a;
}

.ingredient-form {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.step-form {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #f5f3ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b6355;
  flex-shrink: 0;
  margin-top: 16rpx;
}

.textarea {
  flex: 1;
  height: 120rpx;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: 1rpx solid #e8e4de;
}

.delete-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #a8a08e;
}

.flex-1 {
  flex: 1;
}
