.page {
  min-height: 100vh;
  background-color: #faf9f7;
  padding: 80rpx 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 56rpx;
  font-weight: 700;
  color: #252220;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #a8a08e;
  margin-top: 16rpx;
  display: block;
}

.form {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 2px 8px rgba(37, 34, 32, 0.06);
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #252220;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #f5f3ef;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.btn {
  margin-top: 16rpx;
}

.toggle {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #c9583a;
}
