.page { min-height: 100vh; background: var(--color-bg); padding: 80rpx 40rpx; }
.header { text-align: center; margin-bottom: 60rpx; }
.title { font-size: 56rpx; font-weight: 700; color: var(--color-text); display: block; }
.subtitle { font-size: 28rpx; color: var(--color-text-muted); display: block; margin-top: 12rpx; }
.form { background: var(--color-bg-card); border-radius: 24rpx; padding: 40rpx; box-shadow: var(--shadow-sm); }
.form-group { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 12rpx; }
.form-input { height: 80rpx; padding: 0 24rpx; background: var(--color-bg-subtle); border-radius: 16rpx; font-size: 28rpx; }
.submit-btn { height: 88rpx; background: var(--color-primary); color: #fff; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; margin-top: 16rpx; }
.submit-btn:active { opacity: 0.8; }
.toggle { text-align: center; margin-top: 28rpx; font-size: 26rpx; color: var(--color-primary); }
